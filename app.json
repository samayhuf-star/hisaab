{
  "expo": {
    "name": "Hisaab",
    "slug": "hisaab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.samay.hisaab",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "upi"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF6EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.samay.hisaab"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Hisaab uses the camera only to scan item barcodes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C2410C"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Hisaab uses the microphone only when you tap the mic to speak a bill.",
          "speechRecognitionPermission": "Hisaab uses speech recognition only to turn your spoken bill into text."
        }
      ]
    ],
    "scheme": "hisaab",
    "owner": "kroszs-team",
    "extra": {
      "eas": {
        "projectId": "a899980a-8fe4-4f80-af89-2430710b2eac"
      }
    }
  }
}