{
  "expo": {
    "name": "Hisaab",
    "slug": "hisaab",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.samay.hisaab",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "upi"
        ],
        "NSPhotoLibraryUsageDescription": "Hisaab accesses your photos only if you choose an image yourself, for example to read a barcode from a saved picture. It never browses your library.",
        "NSCameraUsageDescription": "Hisaab uses the camera only to scan item barcodes.",
        "NSMicrophoneUsageDescription": "Hisaab uses the microphone only when you tap the mic to speak a bill.",
        "NSSpeechRecognitionUsageDescription": "Hisaab uses speech recognition only to turn your spoken bill into text.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF6EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.samay.hisaab"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#FFF5EA"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Hisaab uses the camera only to scan item barcodes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C2410C"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Hisaab uses the microphone only when you tap the mic to speak a bill.",
          "speechRecognitionPermission": "Hisaab uses speech recognition only to turn your spoken bill into text."
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "disableLocation": true
        }
      ]
    ],
    "scheme": "hisaab",
    "owner": "krosz",
    "extra": {
      "eas": {
        "projectId": "a899980a-8fe4-4f80-af89-2430710b2eac"
      },
      "privacyPolicyUrl": "https://machine.esamay.live/hisaab/privacy"
    },
    "description": "Hisaab is a simple GST billing and accounts app for small businesses. Make bills, track stock and see what you are owed."
  }
}
